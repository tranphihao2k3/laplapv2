{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://laplapcantho.store",
          "https://www.laplapcantho.store"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "content-type"]
      },
      "exposeHeaders": ["content-length", "content-range", "accept-ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
