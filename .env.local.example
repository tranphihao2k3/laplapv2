# ======================================================================
# Biến môi trường cho project laplap-laptop
# ----------------------------------------------------------------------
# Copy file này thành `.env.local` rồi điền giá trị thật:
#   cp .env.local.example .env.local
# (Trên PowerShell:  Copy-Item .env.local.example .env.local)
#
# Lấy key ở đâu?
#   - Supabase (URL, anon key, service role key): https://supabase.com/dashboard
#   - Google AI Studio (Gemini keys):           https://aistudio.google.com/apikey
#   - OpenAI (API key):                          https://platform.openai.com/api-keys
#   - Resend (email):                            https://resend.com/api-keys
#   - Stripe (payment):                          https://dashboard.stripe.com/apikeys
#   - Mini Tool HMAC secret:                     bất kỳ chuỗi ngẫu nhiên ≥ 32 ký tự
# ======================================================================

# ----- Supabase (BẮT BUỘC) -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ----- App branding (tuỳ chọn, dùng làm fallback) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LapLap

# ----- AI parser keys (BẮT BUỘC nếu dùng /quanly/products → AI phân tích) -----
# Chạy không có key → AI phân tích sản phẩm sẽ báo lỗi ngay.
# Tạo key tại: https://aistudio.google.com/apikey (miễn phí).
# Hỗ trợ tối đa 4 key — dùng để xoay vòng khi 1 key hết quota.
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Backup nếu Gemini hết quota hoặc key lỗi. Bỏ trống nếu chỉ dùng Gemini.
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ----- Email (Resend) -----
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# ----- Mini tool (HMAC ký payload upload từ tool ngoài) -----
# Bất kỳ chuỗi ngẫu nhiên, ≥ 32 ký tự. Khi dev chưa set, hệ thống dùng
# placeholder dev-only — KHÔNG an toàn cho production.
MINI_TOOL_SHARED_SECRET=

# ----- Cron jobs -----
CRON_SECRET=

# ----- Stripe -----
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
