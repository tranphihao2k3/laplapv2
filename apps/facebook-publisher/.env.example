# ============================================================
# LapLap Facebook Publisher — Environment Configuration
# ============================================================
#
# Sao chép file này thành `.env` và điền giá trị thật:
#   cp .env.example .env
#
# App KHÔNG đọc trực tiếp file .env — Electron auto-load khi process spawn.
# Phần lớn cấu hình runtime (apiBaseUrl, locale, timeout, ...) người dùng
# sẽ chỉnh qua UI Settings trong app (lưu vào SQLite DB).
#
# File này chỉ chứa:
#   1. Biến môi trường build/dev CI.
#   2. Override hardcoded defaults trong src/main/env.ts.
#   3. URL endpoint backend (LapLap API + Supabase Auth).
#

# ---------------------------------------------------------------
# 1. LapLap API (backend Next.js)
# ---------------------------------------------------------------
# App gọi <apiBaseUrl>/auth/v1/... để login qua Supabase.
# App gọi <apiBaseUrl>/api/... để fetch catalog, groups, etc.
# Production: https://laplapcantho.store  (Cloudflare Workers, OpenNext)
# Local dev:  http://localhost:3000
LAPLAP_API_BASE_URL=https://laplapcantho.store

# ---------------------------------------------------------------
# 2. Supabase (Auth provider cho app desktop)
# ---------------------------------------------------------------
# KHÔNG cấu hình gì ở đây.
#
# App desktop không nói chuyện trực tiếp với Supabase. Nó gọi
# <apiBaseUrl>/auth/v1/... và backend Next.js proxy request đó lên GoTrue
# (xem src/app/auth/v1/[...path]/route.ts ở repo root), tự inject header
# `apikey`. Nhờ vậy anon key nằm server-side, không đóng gói vào installer.
#
# Supabase URL + anon key khai báo ở .env.local của web app:
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY

# ---------------------------------------------------------------
# 3. App runtime defaults (override src/main/env.ts)
# ---------------------------------------------------------------
# Locale UI mặc định: 'vi' | 'en'
LAPLAP_DEFAULT_LOCALE=vi

# HTTP timeout mặc định (ms) — cho LapLap API calls
LAPLAP_HTTP_TIMEOUT_MS=15000

# Playwright timeout mặc định (ms) — cho login/fill/submit trong group
LAPLAP_PLAYWRIGHT_TIMEOUT_MS=45000

# Diagnostics TTL (ms) — screenshot/trace cleanup
LAPLAP_DIAGNOSTICS_TTL_MS=604800000

# ---------------------------------------------------------------
# 4. Electron dev/CI flags
# ---------------------------------------------------------------
# '1' để mở DevTools tự động khi app start (dev only, bị tắt ở prod).
ELECTRON_OPEN_DEVTOOLS=0

# '1' để bypass auth check → render UI mà không cần login Supabase.
# Dùng để xem UI khi chưa cấu hình Supabase. KHÔNG dùng ở production.
ELECTRON_DEV_BYPASS_AUTH=0

# '1' để chạy UI snapshot mode (capture PNG cho CI verification).
# Khi bật, app tự chụp 8 pages ra out/snapshot/ rồi quit.
# ELECTRON_SNAPSHOT_DIR phải được set đồng thời.
ELECTRON_SNAPSHOT_BYPASS_AUTH=0

# Directory output cho snapshot PNG (chỉ dùng khi snapshot mode).
# ELECTRON_SNAPSHOT_DIR=./out/snapshot

# Tắt các security warning của Electron (chỉ dùng dev).
ELECTRON_DISABLE_SECURITY_WARNINGS=1

# ---------------------------------------------------------------
# 5. Build flags (cho electron-builder / installer)
# ---------------------------------------------------------------
# Submit crash report tới Sentry/Bugsnag (chưa implement).
# LAPLAP_ENABLE_CRASH_REPORT=0

# Log level cho main process: 'debug' | 'info' | 'warn' | 'error'
# LAPLAP_LOG_LEVEL=info
