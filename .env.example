# Supabase - lấy từ https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - CHỈ dùng ở server-side, KHÔNG bao giờ expose ra client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LapLap

# AI providers cho module phân tích mô tả sản phẩm (/api/ai/parse-product)
# Chỉ cần điền key cho provider bạn dùng. Gemini có free tier rộng.
GEMINI_API_KEY=
OPENAI_API_KEY=

# URL goc public cua bucket R2 chua Toolcheck.zip + laplap-toolcheck.ps1
# (route system-scan/download). VD: https://pub-xxxx.r2.dev
TOOLCHECK_BASE_URL=

# ============================================================================
# Newsletter (Resend) — gửi email thông báo sản phẩm mới
# ============================================================================
# Resend API key: lấy từ https://resend.com/api-keys (free 100 email/ngày).
# Dùng cho newsletter_subscribers + newsletter_outbox (migration 023).
# Dang ky tai resend.com va verify domain truoc khi gui.
RESEND_API_KEY=

# Dia chi From. Phai la domain da verify trong Resend Dashboard.
# VD: "LapLap <noreply@laplapcantho.store>"
RESEND_FROM_EMAIL=

# Cron secret (random string dai) de cron worker co the goi dispatch.
# Dung cho Vercel Cron hoac GitHub Action goi POST /api/v1/newsletter/dispatch.
# Tao bang: openssl rand -hex 32
CRON_SECRET=

# Resend webhook signing secret. Lay tu Dashboard > Webhooks > Add Endpoint.
# Endpoint URL se la: https://<your-domain>/api/v1/newsletter/webhook
# Can thiet de xu ly bounce/complaint -> auto-deactivate subscriber.
RESEND_WEBHOOK_SECRET=

# URL goc de build link confirm/unsubscribe trong email.
# Neu khong set, server tu detect tu request host (chi work local).
NEXT_PUBLIC_APP_URL=https://laplapcantho.store
